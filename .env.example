# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=cashflow.tondomaine.com

# ── Base de données (DB_HOST=db = nom du service Docker) ──────────────────────
DB_NAME=cashflow_db
DB_USER=root
DB_PASSWORD=change-this-strong-password
DB_HOST=db
DB_PORT=3306

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS & CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://cashflow.tondomaine.com
CSRF_TRUSTED_ORIGINS=https://cashflow.tondomaine.com

# ── Fichiers ──────────────────────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ── Traefik (domaine exposé) ──────────────────────────────────────────────────
DOMAIN=cashflow.tondomaine.com
